# ─────────────────────────────────────────────────────────────────────────────
#  btpAO — Fichier .env.example (Modèle de configuration)
#  Ce fichier est un MODÈLE SÉCURISÉ sans aucun secret réel.
#  Copiez ce fichier en .env à la racine et renseignez vos clés réelles :
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL publique de l'application, utilisee aussi cote backend pour les liens dans
# les emails (reinitialisation de mot de passe, invitations equipe). En prod,
# mettre l'URL reelle du frontend deploye (Vercel ou domaine personnalise).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Repli si NEXT_PUBLIC_APP_URL est absente (meme usage, lu par team.py)
FRONTEND_URL=http://localhost:3000

# ── Supabase Backend & Database ───────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-1-eu-west-3.pooler.supabase.com:6543/postgres

# ── LLM & Intelligence Artificielle ───────────────────────────────────────────
# Clé Anthropic Claude (Requis pour l'analyse DCE et la rédaction de mémoires)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Clé Mistral AI (Optionnel / Fallback)
MISTRAL_API_KEY=your-mistral-api-key-here
# Clé OpenAI (Optionnel / Embeddings)
OPENAI_API_KEY=your-openai-api-key-here

# ── Azure Document Intelligence (OCR premium — Optionnel) ─────────────────────
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-azure-key-here

# ── Redis & Celery Worker ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Optionnel -- "true" force Celery a executer les taches de maniere synchrone,
# sans broker (utile en test/CI uniquement, jamais en production)
CELERY_ALWAYS_EAGER=false

# ── Stockage Fichiers (MinIO local ou S3 AWS) ─────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=btp-storage
S3_REGION=eu-west-3
S3_USE_SSL=false

# ── Facturation Stripe (paiements & abonnements) ───────────────────────────────
# Cle secrete Stripe (cle "test" en developpement, cle "live" en production)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
# Secret de signature du webhook Stripe (Dashboard Stripe > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# ── Recherche Web (sources réglementaires citées — Optionnel) ─────────────────
# Utilisee par le worker Celery ET l'API. Laisser vide desactive la recherche web
# proprement (pas d'erreur, simplement pas de sources web dans les mémoires).
SERPER_API_KEY=your-serper-api-key-here
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
# 'serper', 'brave' ou 'auto' (bascule automatique si le fournisseur choisi échoue)
WEB_SEARCH_PROVIDER=serper

# ── Email (SMTP — réinitialisation mot de passe, invitations équipe) ──────────
# Note : lues directement par app/services/email_service.py (pas via
# app/core/config.py). Tant qu'elles sont vides, les emails ne partent pas mais
# l'application ne plante pas (échec silencieux et volontaire, par design).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=invitations@btpao.fr
SMTP_FROM_NAME=btpAO

# ── CORS — Origines autorisées pour le frontend ────────────────────────────────
# Format JSON obligatoire (liste de chaînes, guillemets doubles). En production,
# mettre l'URL réelle du frontend déployé (Vercel ou domaine personnalisé) --
# une valeur mal formée (JSON invalide) empêche l'API de démarrer.
CORS_ORIGINS=["http://localhost:3000","https://app.btpao.fr"]

# ── Sécurité & Application ────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=generate-a-secure-random-secret-key-32-chars-min
ALLOW_MOCK_FALLBACK=true
CRON_PURGE_SECRET=generate-a-secure-cron-purge-secret-here
E2E_TEST_SECRET=generate-a-secure-e2e-test-secret-here
