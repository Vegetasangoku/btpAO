# ── LLM & IA ─────────────────────────────────────────────────────────────────
# Claude 3.5 Sonnet — Génération principale
ANTHROPIC_API_KEY=sk-ant-api03-REDACTED
# Mistral Large — Fallback
MISTRAL_API_KEY=...
# OpenAI — Embeddings text-embedding-3-small (1536 dims)
OPENAI_API_KEY=sk-...

# ── Azure Document Intelligence (OCR premium) — OPTIONNEL ────────────────────
# Si absent, le système bascule sur pdfplumber/pypdf automatiquement
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://<votre-ressource>.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=<votre_key>

# ── Redis & Celery (auto-configuré via Docker) ───────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Storage MinIO / S3 (auto-configuré via Docker) ──────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=btp-storage
S3_REGION=eu-west-3
S3_USE_SSL=false

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=super-secret-btp-jwt-key-change-in-prod-123456789
ALLOW_MOCK_FALLBACK=true
